# Copy to .env and fill in. .env is gitignored and excluded from backups.

# --- Garmin Connect ---
# Used ONLY for the first interactive login. After that, the library resumes
# from the tokens in GARMINTOKENS and these are not read on a normal sync.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Directory the Garmin library keeps its tokens in. Mount as a Docker volume.
GARMINTOKENS=./.garth

# --- Storage ---
LEDGER_DB_PATH=./data/ledger.db
LEDGER_BACKUP_DIR=./backups

# --- Display ---
# Weights are ALWAYS stored in kg. This only affects rendering.
LEDGER_DISPLAY_UNIT=kg

# --- Planning input for the consistency metric ---
# Sessions you intend to do per week, by kind. Used for "completed vs planned".
LEDGER_PLANNED_LIFT_PER_WEEK=3
LEDGER_PLANNED_RUN_PER_WEEK=3
LEDGER_PLANNED_SOCCER_PER_WEEK=2

# --- Sync throttling. Do not lower these. ---
# Garmin's API is unofficial and blocks accounts that hammer it.
LEDGER_SYNC_CALL_DELAY_S=2.5
LEDGER_SYNC_CHUNK_PAUSE_S=30

# --- League tables and fixtures (optional) ---
# The app can read the standings and schedule of the amateur leagues you play
# in, from two providers: ezleagues (a venue's `<venue>.ezleagues.ezfacility.com`
# site) and DaySmart (the "Dash" member app). Leave these unset if you do not
# play in a league; the Soccer page simply shows no league card.
#
# The ezleagues host is the venue's site, without "https://".
LEDGER_EZLEAGUES_HOST=example.ezleagues.ezfacility.com
# DaySmart: the company slug from the Dash URL
# (apps.daysmartrecreation.com/dash/x/<company>/...), the facility id inside
# that company, the adult-leagues program id, and how to name the venue on a
# league card.
LEDGER_DAYSMART_COMPANY=example
LEDGER_DAYSMART_FACILITY=1
LEDGER_DAYSMART_PROGRAM=1
LEDGER_DAYSMART_PLACE=Indoor venue
# Which leagues to follow, as a JSON list. One entry per standing fixture:
#   provider_id  the league id on the provider — a number for ezleagues, or
#                "daysmart:<id>" for DaySmart
#   my_team      your team's name exactly as the provider spells it
#   fixture      "coed" or "mens" — which weekly fixture this league is
#   path         the "<id>/<slug>" tail of the ezleagues league URL, or the
#                bare id for DaySmart
# Seeds only: once a season is in the database, new seasons are discovered
# automatically and this list is not read again.
LEDGER_LEAGUES=[]
# Example:
# LEDGER_LEAGUES=[{"provider_id":"123456","my_team":"Sparrows FC","fixture":"coed","path":"123456/Fall-Session--Coed-Open"},{"provider_id":"daysmart:42","my_team":"Night Owls","fixture":"mens","path":"42"}]

# --- Network ---
# Which host interface the published port binds to. The default is loopback,
# so the app is reachable only from the machine running it. Set to 0.0.0.0 to
# reach it from the rest of the internal network (http://<host>:8000).
#
# There is NO auth layer, by design, so 0.0.0.0 means everyone on that network
# can read and write the whole record. Internal networks only — never
# port-forward this to the public internet.
#
# Bind to all interfaces rather than to one address: a DHCP lease change would
# leave a hardcoded address unbindable and the container would fail to start.
LEDGER_BIND=127.0.0.1
LEDGER_PORT=8000
